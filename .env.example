# Server Configuration
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/prakhar_portfolio

# Email Configuration (Nodemailer via Gmail)
# 1. Go to your Google Account -> Security -> 2-Step Verification -> App Passwords
# 2. Create an App Password for 'Portfolio' and paste the 16-character code below:
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_digit_app_password

# Where you want to receive portfolio contact notifications (Default is EMAIL_USER if left blank)
RECEIVER_EMAIL=your_email@gmail.com
